# Copy to .env next to compose.yaml (in Dockge: the stack's ".env" box) and fill in.
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
# Exactly the address people open, including http(s)://
PUBLIC_URL=http://localhost:3000
APP_PORT=3000
# Set to false once your team accounts exist; admins can still add members.
ALLOW_SIGNUP=true
# Image tag: latest (main branch), a branch name, or a version like 1.2.0
IMAGE_TAG=latest

# AI reading of delivery/return notes (Anthropic). Leave empty to enter documents by hand.
ANTHROPIC_API_KEY=

# Image search for equipment reference images (optional; api.search.brave.com).
BRAVE_SEARCH_API_KEY=
