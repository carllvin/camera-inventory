POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Exactly the address people open, including https://
PUBLIC_URL=https://camera.example.com
APP_PORT=3000
ALLOW_SIGNUP=true
# Image tag: latest (main branch), a branch name, or a version like 1.2.0
IMAGE_TAG=latest
# Bundled HTTPS proxy (needs ports 80/443 and DNS pointing at this server):
# COMPOSE_PROFILES=proxy
# DOMAIN=camera.example.com

# AI reading of delivery notes (Anthropic). Leave empty to enter documents by hand.
ANTHROPIC_API_KEY=

# Image search for equipment reference images (optional; api.search.brave.com).
# Without it, use "Open in Google Images" + paste the image address, or upload.
BRAVE_SEARCH_API_KEY=
