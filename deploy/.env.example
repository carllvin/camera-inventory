# Copy to ./.env next to compose.yaml and fill in.
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
# Public URL users open (must match exactly, including https://)
PUBLIC_URL=https://camera.example.com
DOMAIN=camera.example.com
APP_PORT=3000
# Set to false after your team accounts exist; admins can still add members.
ALLOW_SIGNUP=true
