# PostgreSQL connection (local dev)
DATABASE_URL=postgres://camera:camera@localhost:5432/camera_inventory
# Separate database used by the integration test suite (it is dropped/recreated)
TEST_DATABASE_URL=postgres://camera:camera@localhost:5432/camera_inventory_test

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# Allow anyone who can reach the app to create an account + workspace
ALLOW_SIGNUP=true

# File storage for photos/documents: local (default) or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# AI reading of delivery/return notes (Anthropic Claude). Without a key, documents
# are entered by hand. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high        # low | medium | high | xhigh | max

# Image search for equipment reference images (optional; api.search.brave.com).
# Without it, use "Open in Google Images" + paste the image address, or upload.
BRAVE_SEARCH_API_KEY=
